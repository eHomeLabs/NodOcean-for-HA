{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "EnOcean stick",
        "description": "Select the EnOcean USB stick (USB300 or compatible) plugged into Home Assistant.",
        "data": {
          "device": "Serial port"
        }
      },
      "manual": {
        "title": "EnOcean stick",
        "description": "Enter the serial port path (e.g. /dev/serial/by-id/usb-EnOcean_GmbH_EnOcean_USB_300_...).",
        "data": {
          "device": "Port path"
        }
      },
      "usb_confirm": {
        "title": "EnOcean stick detected",
        "description": "An EnOcean stick was detected on {path}. Do you want to use it?"
      }
    },
    "error": {
      "cannot_open": "Cannot open the serial port ({error}). It is probably already used by another integration or add-on (native EnOcean integration, EnOcean MQTT add-on…).",
      "no_response": "The port opens but the stick does not answer (EnOcean ESP3 protocol). Check that it is the EnOcean stick and that no add-on is using it.",
      "native_enocean": "The native Home Assistant EnOcean integration is active: remove it first, otherwise the stick stays busy."
    },
    "abort": {
      "already_configured": "This EnOcean stick is already configured."
    }
  },
  "config_subentries": {
    "device": {
      "initiate_flow": {
        "user": "Add a NodOn product"
      },
      "entry_type": "NodOn product",
      "step": {
        "user": {
          "title": "Add a NodOn product",
          "description": "Choose the NodOn product to add. Everything is preconfigured: nothing else to fill in.",
          "data": {
            "model": "Product"
          }
        },
        "instructions": {
          "title": "{model} — {name}",
          "description": "{image}**Get ready to pair:**\n\n{instructions}\n\nClick **Submit** to start listening ({timeout} s), then do the steps above."
        },
        "timeout": {
          "title": "No product detected",
          "description": "No pairing request from the **{model}** was received.\n\n- Move the product closer to the EnOcean stick (less than 10 m while pairing).\n- Check that it is powered (or exposed to light for solar sensors).\n- Repeat the steps: {instructions}",
          "data": {
            "action": "What do you want to do?"
          }
        },
        "manual": {
          "title": "Manual entry",
          "description": "Enter the 8-character EnOcean ID printed on the product or its packaging (e.g. 0512AB34).",
          "data": {
            "device_id": "EnOcean ID"
          }
        },
        "confirm": {
          "title": "Product detected!",
          "description": "**{model}** detected — ID `{device_id}`, signal {rssi}.\n\n{after}\n\nGive it a name and choose the area where it is installed.",
          "data": {
            "name": "Name",
            "area_id": "Area",
            "new_area": "Or new area"
          },
          "data_description": {
            "name": "For example “EnOcean Smart Plug NodOn”.",
            "area_id": "Existing area where the product is installed (optional).",
            "new_area": "If the area does not exist yet, type its name (e.g. “Garage”): it will be created."
          }
        }
      },
      "progress": {
        "pairing": "{image}**Waiting for the {model}…**\n\n{instructions}\n\nListening lasts {timeout} seconds."
      },
      "error": {
        "invalid_id": "Invalid ID: 8 hexadecimal characters expected."
      },
      "abort": {
        "already_configured": "This product is already configured.",
        "gateway_not_ready": "The EnOcean stick is not ready. Check its connection and try again."
      }
    }
  },
